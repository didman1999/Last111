{
  "version": 2,
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "routes": [
    { "src": "/", "dest": "/index.html" },
    { "src": "/collection", "dest": "/collection.html" },
    { "src": "/product", "dest": "/product.html" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
